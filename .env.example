# Supabase del entorno local/de desarrollo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Generá una clave con: openssl rand -base64 32
SUPABASE_SERVICE_ROLE_KEY=
JETREE_CREDENTIALS_ENCRYPTION_KEY=
JETREE_WORKSPACE_DAILY_EXECUTION_LIMIT=
JETREE_TELEGRAM_WORKER_SECRET=

# OAuth de conectores (GitHub OAuth App con scope read:user/public_repo y Google OAuth con scope drive.file)
JETREE_APP_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# No incluyas aquí secretos reales ni uses credenciales de producción.
# Las claves de proveedores y tokens de Telegram deben permanecer del lado servidor.
